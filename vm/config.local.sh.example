# Machine-specific values for vm/*.sh -- copy this file to config.local.sh
# (gitignored, never committed) and fill in your own environment.

VM_NAME="your-vm-name"
VM_ZONE="us-central1-c"
VM_PROJECT="your-gcp-project-id"

# Remote paths on the VM.
PROXY_DIR="/home/YOUR_REMOTE_USER/vertex-proxy"
SWARM_DIR="/home/YOUR_REMOTE_USER/swarm"
PROXY_PORT=8000
