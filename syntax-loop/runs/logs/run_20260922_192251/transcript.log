    "expressivity":     {"impact": "...", "reasoning": "..."},
    "determinism":      {"impact": "...", "reasoning": "..."},
    "interpretability": {"impact": "...", "reasoning": "..."},
    "improvement":      {"impact": "...", "reasoning": "..."}
  },
  "simulations": [
    {"item_id": "...", "source": "...", "nl": "<the task>", "braincode": "<your expression>",
