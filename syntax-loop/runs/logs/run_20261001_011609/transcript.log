lied(target, deadline) -> BOOL [VALUE]\n-- file_age_days(target) -> NUMBER [VALUE]\n-- path_in_folder(target, destination) -> BOOL [VALUE]\n-- create_list(target) -> REF[STRING] [NEW]\n-- add_to_list(target, destination) -> NONE\n-- check_support_status(target, metric) -> BOOL [VALUE]\n-- offer_discount(target, [content]) -> NONE\n-- offer_expedited_shipping(target, [content]) -> NONE\n-- custom_<domain>_<verb>(target, [content, destination]) -> NONE",
