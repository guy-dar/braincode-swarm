]}, {"symbol": "ask", "gloss": "Ask a question.", "nl_synonyms": []}, {"symbol": "inform", "gloss": "State information.", "nl_synonyms": []}, {"symbol": "respond", "gloss": "Answer.", "nl_synonyms": []}, {"symbol": "propose", "gloss": "Propose an idea.", "nl_synonyms": []}, {"symbol": "correct", "gloss": "Correct a statement.", "nl_synonyms": []}, {"symbol": "acknowledge", "gloss": "Acknowledge.", "nl_synonyms": []}, {"symbol": "confirm", "gloss": "Confirm.", "nl_synonyms": []}, {"symbol": "decline", "gloss": "Decline.", "nl_synonyms": []}], "membership_rule": "Custom operations are formed as `custom_<domain>_<verb>`. Domain is the first match in {web, household, code, communication, filesystem, application, support} applicable to the target. Verb is the lemmatized, lowercase, underscore-joined head verb of the source action. If the verb matches a listed operation's synonym, the listed operation must be used. Synonyms are mutually exclusive functions.", "worked_example": {"nl": "Examine a book.", "braincode": "ACTION custom_household_examine(target=\"book\", content=\"examine\")"}, "change_type": "MAJOR", "rationale": "Replaces the circular rule with an exhaustive list of all retained operations and a deterministic custom operation algorithm.", "addresses_note": "N2"}, {"op": "add", "kind": "vocabulary", "construct_name": "attribute-name", "glossary_gloss": "The complete index of attributes allowed in Action, UTTER, GENERATE, and TASK context clauses.", "closed": true, "members": [{"symbol": "target", "gloss": "Subject/artifact.", "nl_synonyms": []}, {"symbol": "destination", "gloss": "Destination.", "nl_synonyms": []}, {"symbol": "source", "gloss": "Source.", "nl_synonyms": []}, {"symbol": "relation", "gloss": "Spatial relation.", "nl_synonyms": []}, {"symbol": "destination_location", "gloss": "Nested anchor.", "nl_synonyms": []}, {"symbol": "destination_relation", "gloss": "Relation to anchor.", "nl_synonyms": []}, {"symbol": "content", "gloss": "Transitional STRING payload.", "nl_synonyms": []}, {"symbol": "recipient", "gloss": "Communication recipient.", "nl_synonyms": []}, {"symbol": "audience", "gloss": "Named reader.", "nl_synonyms": []}, {"symbol": "audience_role", "gloss": "Reader role.", "nl_synonyms": []}, {"symbol": "tone", "gloss": "Register.", "nl_synonyms": []}, {"symbol": "register_note", "gloss": "Transitional register.", "nl_synonyms": []}, {"symbol": "format", "gloss": "Artifact format.", "nl_synonyms": []}, {"symbol": "style", "gloss": "Artifact style.", "nl_synonyms": []}, {"symbol": "locale", "gloss": "Artifact locale.", "nl_synonyms": []}, {"symbol": "quantity", "gloss": "Exact count.", "nl_synonyms": []}, {"symbol": "duration", "gloss": "Numeric duration.", "nl_synonyms": []}, {"symbol": "duration_unit", "gloss": "Duration unit.", "nl_synonyms": []}, {"symbol": "execution_date", "gloss": "TASK context anchor.", "nl_synonyms": []}, {"symbol": "origin", "gloss": "Travel origin.", "nl_synonyms": []}, {"symbol": "date", "gloss": "Travel date.", "nl_synonyms": []}, {"symbol": "return_date", "gloss": "Travel return.", "nl_synonyms": []}, {"symbol": "passengers", "gloss": "Passenger count.", "nl_synonyms": []}, {"symbol": "near", "gloss": "Transit near.", "nl_synonyms": []}, {"symbol": "location", "gloss": "Search location.", "nl_synonyms": []}, {"symbol": "distance", "gloss": "Search distance.", "nl_synonyms": []}, {"symbol": "min_rating", "gloss": "Minimum rating.", "nl_synonyms": []}, {"symbol": "max_price", "gloss": "Maximum price.", "nl_synonyms": []}, {"symbol": "currency", "gloss": "Price currency.", "nl_synonyms": []}, {"symbol": "genre", "gloss": "Search genre.", "nl_synonyms": []}, {"symbol": "category", "gloss": "Search category.", "nl_synonyms": []}, {"symbol": "color", "gloss": "Search color.", "nl_synonyms": []}, {"symbol": "size", "gloss": "Search size.", "nl_synonyms": []}, {"symbol": "shape", "gloss": "Search shape.", "nl_synonyms": []}, {"symbol": "availability", "gloss": "Search stock.", "nl_synonyms": []}, {"symbol": "audience_class", "gloss": "Search demographic.", "nl_synonyms": []}, {"symbol": "rank_field", "gloss": "Sort field.", "nl_synonyms": []}, {"symbol": "rank_direction", "gloss": "Sort direction.", "nl_synonyms": []}, {"symbol": "ordering", "gloss": "Legacy sort order.", "nl_synonyms": []}, {"symbol": "limit", "gloss": "Extract member count.", "nl_synonyms": []}, {"symbol": "deadline", "gloss": "Reply UTC_TIMESTAMP.", "nl_synonyms": []}, {"symbol": "metric", "gloss": "Support metric.", "nl_synonyms": []}, {"symbol": "discount_percent", "gloss": "Discount percentage.", "nl_synonyms": []}, {"symbol": "module", "gloss": "Code module.", "nl_synonyms": []}, {"symbol": "class", "gloss": "Code class.", "nl_synonyms": []}, {"symbol": "function", "gloss": "Code function.", "nl_synonyms": []}, {"symbol": "call", "gloss": "Code call.", "nl_synonyms": []}, {"symbol": "argument", "gloss": "Code argument.", "nl_synonyms": []}, {"symbol": "assertion", "gloss": "Code assertion.", "nl_synonyms": []}, {"symbol": "reproduction_step", "gloss": "Bug reproduction.", "nl_synonyms": []}, {"symbol": "expected_output", "gloss": "Expected behavior.", "nl_synonyms": []}, {"symbol": "actual_output", "gloss": "Observed behavior.", "nl_synonyms": []}, {"symbol": "environment", "gloss": "Runtime environment.", "nl_synonyms": []}, {"symbol": "platform", "gloss": "Platform.", "nl_synonyms": []}, {"symbol": "test_id", "gloss": "Test identifier.", "nl_synonyms": []}, {"symbol": "exclude", "gloss": "Generation exclusion.", "nl_synonyms": []}, {"symbol": "instrument", "gloss": "Action instrument.", "nl_synonyms": []}], "membership_rule": null, "worked_example": {"nl": "Search flights from Tel Aviv to Berlin next Tuesday for two passengers.", "braincode": "ACTION search_travel(origin=\"Tel Aviv\", destination=\"Berlin\", date=\"2025-06-10\", passengers=2) -> flights : LIST[REF[STRING]]"}, "change_type": "MAJOR", "rationale": "Audited complete index of attributes, adding exclude and instrument, and fixing deadline to UTC_TIMESTAMP.", "addresses_note": "N2"}, {"op": "add", "kind": "vocabulary", "construct_name": "entity-name", "glossary_gloss": "Canonical entity and location base nouns.", "closed": false, "members": [{"symbol": "mug", "gloss": "Drinking cup.", "nl_synonyms": []}, {"symbol": "rag", "gloss": "Cleaning cloth.", "nl_synonyms": []}, {"symbol": "tub", "gloss": "Bathtub.", "nl_synonyms": []}, {"symbol": "book", "gloss": "Reading material.", "nl_synonyms": []}, {"symbol": "mirror", "gloss": "Reflective item.", "nl_synonyms": []}, {"symbol": "sink", "gloss": "Washing basin.", "nl_synonyms": []}, {"symbol": "counter", "gloss": "Countertop surface.", "nl_synonyms": []}, {"symbol": "cupboard", "gloss": "Storage cabinet.", "nl_synonyms": []}, {"symbol": "refrigerator", "gloss": "Cooling appliance.", "nl_synonyms": ["fridge"]}, {"symbol": "spoon", "gloss": "Eating utensil.", "nl_synonyms": []}, {"symbol": "bowl", "gloss": "A bowl.", "nl_synonyms": []}], "membership_rule": "A generic entity or location is lowercase_underscore.", "worked_example": {"nl": "Rinse a rag off in the sink and put it inside of the tub.", "braincode": "ACTION pick_up(target=\"rag\") -> rag : REF[STRING]\nACTION rinse(target=rag, destination=\"sink\") -> rinsed_rag : REF[STRING]\nACTION place(target=rinsed_rag, destination=\"tub\", relation=in)"}, "change_type": "MAJOR", "rationale": "Provides the base entity nouns, separated from states and modifiers to avoid semantic overlap.", "addresses_note": "N2"}, {"op": "add", "kind": "vocabulary", "construct_name": "spatial-relation", "glossary_gloss": "The closed set of relations used when placing one entity relative to another.", "closed": true, "members": [{"symbol": "in", "gloss": "Contained within.", "nl_synonyms": ["inside"]}, {"symbol": "on", "gloss": "Resting atop.", "nl_synonyms": ["on top of"]}, {"symbol": "under", "gloss": "Beneath.", "nl_synonyms": ["below"]}, {"symbol": "next_to", "gloss": "Adjacent to.", "nl_synonyms": ["beside"]}, {"symbol": "left_of", "gloss": "To the left of.", "nl_synonyms": ["left of"]}, {"symbol": "right_of", "gloss": "To the right of.", "nl_synonyms": ["right of"]}, {"symbol": "in_front_of", "gloss": "Positioned in front of.", "nl_synonyms": ["in front of"]}, {"symbol": "behind", "gloss": "Positioned behind.", "nl_synonyms": []}], "membership_rule": null, "worked_example": {"nl": "Put the bowl right of the spoon.", "braincode": "ACTION pick_up(target=\"bowl\") -> bowl : REF[STRING]\nACTION pick_up(target=\"spoon\") -> spoon : REF[STRING]\nACTION place(target=bowl, destination=spoon, relation=right_of)"}, "change_type": "MINOR", "rationale": "Supplies the directional relations required by sampled household placement tasks.", "addresses_note": "N2"}, {"op": "add", "kind": "vocabulary", "construct_name": "search-value", "glossary_gloss": "Canonical values for search, filtering, ranking, currency, genre, category, and availability attributes.", "closed": false, "members": [{"symbol": "price", "gloss": "Rank or filter field: monetary cost.", "nl_synonyms": ["cheapest", "lowest price"]}, {"symbol": "rating", "gloss": "Rank or filter field: user or critic score.", "nl_synonyms": []}, {"symbol": "distance", "gloss": "Rank field: proximity.", "nl_synonyms": ["nearest", "closest"]}, {"symbol": "asc", "gloss": "Ascending rank direction.", "nl_synonyms": ["lowest first"]}, {"symbol": "desc", "gloss": "Descending rank direction.", "nl_synonyms": ["highest first"]}, {"symbol": "usd", "gloss": "United States dollar currency.", "nl_synonyms": ["$"]}, {"symbol": "game", "gloss": "Category: video game.", "nl_synonyms": []}, {"symbol": "limited_time_offers", "gloss": "Category: time-limited deals.", "nl_synonyms": []}, {"symbol": "in_stock", "gloss": "Available for purchase now.", "nl_synonyms": ["available"]}, {"symbol": "out_of_stock", "gloss": "Unavailable for purchase now.", "nl_synonyms": ["sold out"]}], "membership_rule": "Members belong to one facet: rank-field, rank-direction, currency, genre, category, or availability. rank_field accepts one rank-field symbol or a LIST of them; rank_direction accepts asc or desc.", "worked_example": {"nl": "Find the cheapest mirror under $20.", "braincode": "ACTION search_web(target=\"mirror\", currency=usd, max_price=20) -> mirrors : LIST[REF[STRING]]\nACTION sort(target=mirrors, rank_field=price, rank_direction=asc) -> sorted_mirrors : LIST[REF[STRING]]"}, "change_type": "MAJOR", "rationale": "Adds typed search and ranking vocabulary.", "addresses_note": "N2"}, {"op": "add", "kind": "vocabulary", "construct_name": "role-recipient", "glossary_gloss": "Canonical social or organizational roles used as recipients and audiences.", "closed": false, "members": [{"symbol": "user", "gloss": "The requesting human.", "nl_synonyms": []}, {"symbol": "agent", "gloss": "The assistant.", "nl_synonyms": []}, {"symbol": "manager", "gloss": "The user's manager.", "nl_synonyms": ["boss"]}, {"symbol": "customer", "gloss": "A customer.", "nl_synonyms": []}, {"symbol": "professor", "gloss": "An instructor.", "nl_synonyms": ["teacher"]}, {"symbol": "support_agent", "gloss": "A customer-support representative.", "nl_synonyms": []}], "membership_rule": "A lowercase_underscore relationship or institutional role.", "worked_example": {"nl": "Send a polite email to my manager.", "braincode": "ACTION send_email(recipient=manager, content=\"follow-up\", tone=polite)"}, "change_type": "MINOR", "rationale": "Provides an individually look-upable recipient category.", "addresses_note": "N2"}, {"op": "add", "kind": "vocabulary", "construct_name": "tone-value", "glossary_gloss": "The closed set of canonical tone values used by communication, utterance, and generation attributes.", "closed": true, "members": [{"symbol": "formal", "gloss": "Professional and conventional.", "nl_synonyms": []}, {"symbol": "polite", "gloss": "Courteous.", "nl_synonyms": []}, {"symbol": "neutral", "gloss": "Neither warm nor hostile.", "nl_synonyms": []}, {"symbol": "urgent", "gloss": "Emphasizes time sensitivity.", "nl_synonyms": []}, {"symbol": "casual", "gloss": "Informal and relaxed.", "nl_synonyms": ["casually"]}, {"symbol": "friendly", "gloss": "Warm and approachable.", "nl_synonyms": []}, {"symbol": "empathetic", "gloss": "Shows understanding of feelings.", "nl_synonyms": []}, {"symbol": "firm", "gloss": "Clear and assertive.", "nl_synonyms": []}, {"symbol": "apologetic", "gloss": "Expresses regret.", "nl_synonyms": []}, {"symbol": "persuasive", "gloss": "Intended to convince.", "nl_synonyms": []}, {"symbol": "humorous", "gloss": "Intended to amuse.", "nl_synonyms": ["funny"]}, {"symbol": "supportive", "gloss": "Offers encouragement or help.", "nl_synonyms": []}, {"symbol": "concise", "gloss": "Brief tone.", "nl_synonyms": []}, {"symbol": "detailed", "gloss": "Detailed tone.", "nl_synonyms": []}], "membership_rule": "When a symbol (e.g., detailed, concise) exists in multiple categories, it is resolved by the expected category of the attribute it binds to.", "worked_example": {"nl": "Send a polite follow-up.", "braincode": "ACTION send_email(recipient=manager, content=\"follow-up\", tone=polite)"}, "change_type": "MINOR", "rationale": "Supplies the real glossary category already required by Action, Utterance, and Generate semantics, with a global disambiguation rule.", "addresses_note": "N2"}, {"op": "add", "kind": "vocabulary", "construct_name": "artifact-specification", "glossary_gloss": "Canonical artifact targets and generation facets for format, style, locale, and duration units.", "closed": false, "members": [{"symbol": "story", "gloss": "Artifact: narrative story.", "nl_synonyms": []}, {"symbol": "short_text", "gloss": "Artifact: short constrained text.", "nl_synonyms": []}, {"symbol": "technical_introduction", "gloss": "Artifact: introductory technical explanation.", "nl_synonyms": []}, {"symbol": "contract", "gloss": "Artifact: agreement or contract.", "nl_synonyms": []}, {"symbol": "structured_report", "gloss": "Artifact: headed report.", "nl_synonyms": []}, {"symbol": "character_profile", "gloss": "Artifact: fictional character profile.", "nl_synonyms": []}, {"symbol": "scene", "gloss": "Artifact: dramatic or narrative scene.", "nl_synonyms": []}, {"symbol": "plan", "gloss": "Artifact: actionable plan.", "nl_synonyms": []}, {"symbol": "bullet_points", "gloss": "Format: bullet list.", "nl_synonyms": []}, {"symbol": "structured_sections", "gloss": "Format: headed sections.", "nl_synonyms": []}, {"symbol": "paragraph", "gloss": "Format: prose paragraph form.", "nl_synonyms": []}, {"symbol": "balanced", "gloss": "Style: presents competing perspectives fairly.", "nl_synonyms": []}, {"symbol": "detailed", "gloss": "Style: extensive detail.", "nl_synonyms": ["thorough"]}, {"symbol": "concise", "gloss": "Style: brief.", "nl_synonyms": ["brief"]}, {"symbol": "en_us", "gloss": "Locale: United States English.", "nl_synonyms": ["English"]}, {"symbol": "day", "gloss": "Duration unit: calendar day.", "nl_synonyms": ["days"]}, {"symbol": "hour", "gloss": "Duration unit: hour.", "nl_synonyms": ["hours"]}, {"symbol": "week", "gloss": "Duration unit: seven-day week.", "nl_synonyms": ["weeks"]}], "membership_rule": "Each member belongs to exactly one facet: artifact target, format, style, locale, or duration unit. When a symbol (e.g., detailed) exists in multiple categories, it is resolved by the attribute's expected category.", "worked_example": {"nl": "Write a balanced structured report for a two-week project.", "braincode": "GENERATE(target=structured_report, content=\"project report\", duration=2, duration_unit=week, format=structured_sections, style=balanced) -> report : STRING"}, "change_type": "MAJOR", "rationale": "Adds the missing artifact-type category and fixes duration by making its unit an explicit glossary value.", "addresses_note": "N2"}, {"op": "revise", "construct_name": "Action", "grammar": "action ::= \"ACTION\" operation-id \"(\" action-attrs? \")\" (\"->\" IDENT \":\" type)?\naction-attrs ::= action-attr (\",\" action-attr)*\naction-attr ::= attribute-name \"=\" value\noperation-id ::= operation-vocabulary member\n\nSignatures: search_web(target, [audience_class,availability,category,color,currency,distance,genre,location,max_price,min_rating,shape,size]); search_travel(origin,destination,date,[passengers,return_date]); search_transit(origin,destination,[date,near]); sort(target,rank_field,rank_direction) | legacy sort(target,ordering); extract(target,limit); read_page(target,[content]); pick_up(target,[source]); place(target,destination,[destination_location,destination_relation,relation]); modify_code(target,[actual_output,argument,assertion,call,class,content,environment,expected_output,function,module,platform,reproduction_step]); run_tests(target,[test_id]); send_email/send_message(recipient,content,[tone]); check_replied(target,deadline); check_support_status(target,metric); offer_discount(target,[content,discount_percent]); offer_expedited_shipping(target,[content]); custom_<domain>_<verb>(target,[content,destination,instrument]). Other operations retain their prior signatures.", "semantics": "An Action attribute is valid only if it is an attribute-name member and is listed in that operation's signature. Attributes must be emitted in exactly their declared signature order, followed by any optional attributes in alphabetical order. When the source text does not impose a sequential order for independent steps, they must be emitted in alphabetical order of their operations, breaking ties by target. Category-valued attributes must use the category required by attribute-name. Dedicated search attributes are canonical: a criterion represented by a dedicated attribute must not also appear in select_filter/apply_filters content. Existing result categories, REF/coreference behavior, and all prior listed operation signatures remain unchanged. Custom operations use the deterministic operation-vocabulary rule.", "worked_example": {"nl": "Find the lowest-priced mirror in stock under $20.", "braincode": "ACTION search_web(target=\"mirror\", availability=in_stock, currency=usd, max_price=20) -> mirrors : LIST[REF[STRING]]\nACTION sort(target=mirrors, rank_field=price, rank_direction=asc) -> sorted_mirrors : LIST[REF[STRING]]"}, "glossary_gloss": "Action now validates every attribute against the complete attribute index and an operation-specific signature, enforcing a canonical attribute order.", "change_type": "MAJOR", "rationale": "Enforces a canonical attribute order and exhaustive attribute validation.", "cites_source": "HTML", "addresses_note": "N2"}, {"op": "revise", "construct_name": "Generate", "grammar": "generation ::= \"GENERATE\" \"(\" generate-attr (\",\" generate-attr)* \")\" \"->\" IDENT \":\" gen_type\ngenerate-attr ::= \"target\" \"=\" artifact-target | \"audience\" \"=\" STRING | \"audience_role\" \"=\" role-recipient | \"content\" \"=\" STRING | \"duration\" \"=\" NUMBER | \"duration_unit\" \"=\" duration-unit | \"exclude\" \"=\" STRING | \"format\" \"=\" artifact-format | \"locale\" \"=\" artifact-locale | \"quantity\" \"=\" UNSIGNED_INT | \"style\" \"=\" artifact-style | \"tone\" \"=\" tone-value\ngen_type ::= \"NUMBER\" | \"STRING\" | \"BOOL\" | \"LIST\" \"[\" gen_type\"]\"", "semantics": "Only the listed Generate attributes are legal. Attributes must be emitted in exactly their declared signature order (target, then optional attributes in alphabetical order). Independent sequential generated steps without a source-imposed order must be emitted in alphabetical order of their target values. target is required and is an artifact-specification target member. format, style, locale, and duration_unit use their matching artifact-specification facets; tone uses tone-value; audience_role uses role-recipient. duration and duration_unit must occur together. content and exclude remain transitional STRING channels. All prior GENERATE result, REF prohibition, and exact quantity semantics remain unchanged.", "worked_example": {"nl": "Write ten funny short texts in English.", "braincode": "GENERATE(target=short_text, content=\"about finding quahogs on a beach\", locale=en_us, quantity=10, tone=humorous) -> texts : LIST[STRING]"}, "glossary_gloss": "GENERATE now accepts only documented artifact, audience, register, duration, exclude, and transitional-content attributes, enforcing canonical attribute order.", "change_type": "MAJOR", "rationale": "Supplies normative Generate applicability, canonical ordering, and exclude attribute.", "cites_source": "HTML", "addresses_note": "N2"}, {"op": "revise", "construct_name": "Utterance", "grammar": "utterance ::= \"UTTER\" speech-act \"(\" utter-attr (\",\" utter-attr)* \")\" (\"->\" IDENT)?\nspeech-act ::= operation-vocabulary speech-act member\nutter-attr ::= \"audience\" \"=\" STRING | \"content\" \"=\" STRING | \"recipient\" \"=\" (role-recipient | STRING) | \"register_note\" \"=\" STRING | \"target\" \"=\" STRING | \"tone\" \"=\" tone-value", "semantics": "UTTER accepts only the listed attributes, all of which are indexed by attribute-name. Attributes must be emitted in alphabetical order. Independent sequential UTTER steps without a source-imposed order must be emitted in alphabetical order of their speech acts. tone and register_note remain mutually exclusive. content remains a transitional STRING payload during the vocabulary-building phase, and UTTER remains legal only inside a CONVO TURN.", "worked_example": {"nl": "User casually thanks the agent.", "braincode": "CONVO Thanks {\n  TURN t1 SPEAKER=USER {\n    UTTER acknowledge(content=\"Thanks\", recipient=agent, tone=casual)\n  }\n}"}, "glossary_gloss": "Utterance now uses the complete attribute gate and enforces canonical attribute ordering, preserving conversational prose content during the build phase.", "change_type": "MAJOR", "rationale": "Ensures the claimed attribute index is normatively complete for UTTER and enforces canonical ordering.", "cites_source": null, "addresses_note": "N2"}], "_provider_used": "gemini", "_model_used": "gemini-3.1-pro-preview"}
