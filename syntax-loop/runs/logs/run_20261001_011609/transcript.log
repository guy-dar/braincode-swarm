        {"symbol": "==", "gloss": "Equality.", "nl_synonyms": []},
        {"symbol": "!=", "gloss": "Inequality.", "nl_synonyms": []},
        {"symbol": "<", "gloss": "Less-than.", "nl_synonyms": []},
        {"symbol": "<=", "gloss": "Less-or-equal.", "nl_synonyms": []},
        {"symbol": ">", "gloss": "Greater-than.", "nl_synonyms": []},
        {"symbol": ">=", "gloss": "Greater-or-equal.", "nl_synonyms": []},
        {"symbol": "UTC_TIMESTAMP", "gloss": "A STRING matching YYYY-MM-DDThh:mm:ssZ.", "nl_synonyms": []}
      ],
      "membership_rule": "Lexical rules: IDENT is `[a-zA-Z_][a-zA-Z0-9_]*`. UNSIGNED_INT is `0` or `[1-9][0-9]*`. HEX is `[0-9a-fA-F]`. COMMENT is `#` to line end. ISO_DATE is `YYYY-MM-DD`. UTC_TIMESTAMP is `YYYY-MM-DDThh:mm:ssZ`. Whitespace (space, tab, newline) separates tokens but has no semantic meaning.",
      "worked_example": {
        "nl": "If true, return one.",
        "braincode": "ENTRYPOINT IfTrue\nTASK IfTrue : NUMBER {\n  LET one : NUMBER = 1\n  IF TRUE THEN {\n    LET two : NUMBER = 2\n  }\n  RETURN one\n}"
      },
      "change_type": "MAJOR",
      "rationale": "Completes the structural word inventory and exact lexical rules as required.",
      "addresses_note": "N2"
    },
