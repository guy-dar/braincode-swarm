   "grammar": "action ::= \"ACTION\" operation-id \"(\" action-attrs? \")\" (\"->\" IDENT \":\" type)?\naction-attrs ::= action-attr (\",\" action-attr)*\naction-attr ::= attribute-name \"=\" value\noperation-id ::= operation-vocabulary member\n\nSignatures: search_web(target, [audience_class,availability,category,color,currency,distance,genre,location,max_price,min_rating,shape,size]); search_travel(origin,destination,date,[passengers,return_date]); search_transit(origin,destination,[date,near]); sort(target,rank_field,rank_direction) | legacy sort(target,ordering); extract(target,limit); read_page(target,[content]); pick_up(target,[source]); place(target,destination,[destination_location,destination_relation,relation]); modify_code(target,[actual_output,argument,assertion,call,class,content,environment,expected_output,function,module,platform,reproduction_step]); run_tests(target,[test_id]); send_email/send_message(recipient,content,[tone]); check_replied(target,deadline); check_support_status(target,metric); offer_discount(target,[content,discount_percent]); offer_expedited_shipping(target,[content]); custom_<domain>_<verb>(target,[content,destination,instrument]). Other operations retain their prior signatures.",
