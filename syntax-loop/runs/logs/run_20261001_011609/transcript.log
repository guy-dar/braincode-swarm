-- save_favorite(target) -> NONE
-- add_to_cart(target) -> NONE
-- pick_up(target, [source]) -> REF[STRING] [SAME]
-- place(target, destination, [destination_location, destination_relation, relation]) -> NONE
-- heat(target, [destination]) -> REF[STRING] [SAME]
-- chill(target, [destination]) -> REF[STRING] [SAME]
-- rinse(target, destination) -> REF[STRING] [SAME]
-- slice(target) -> LIST[REF[STRING]] [NEW]
-- pour(target, destination) -> NONE
-- open_container(target) -> NONE
-- close_container(target) -> NONE
-- turn_on(target) -> NONE
-- turn_off(target) -> NONE
-- modify_code(target, [actual_output, argument, assertion, call, class, content, environment, expected_output, function, module, platform, reproduction_step]) -> NONE
-- run_tests(target, [test_id]) -> NONE
-- add_file(target, content) -> NONE
-- delete_file(target) -> NONE
-- send_email(recipient, content, [tone]) -> NONE
-- send_message(recipient, content, [tone]) -> NONE
-- call(recipient) -> NONE
-- check_replied(target, deadline) -> BOOL [VALUE]
-- file_age_days(target) -> NUMBER [VALUE]
-- path_in_folder(target, destination) -> BOOL [VALUE]
-- create_list(target) -> REF[STRING] [NEW]
-- add_to_list(target, destination) -> NONE
-- check_support_status(target, metric) -> BOOL [VALUE]
-- offer_discount(target, [content, discount_percent]) -> NONE
-- offer_expedited_shipping(target, [content]) -> NONE
-- custom_<domain>_<verb>(target, [content, destination, instrument]) -> NONE` — An Action attribute is valid only if it is an attribute-name member, its value conforms to the attribute's declared category/rule, and it is listed in that operation's signature. Canonical ordering rule: Attributes must be emitted in exactly their declared signature order (required first, then optional), with any optional attributes present sorted alphabetically by attribute name. When the source text does not impose a sequential order for independent steps, emit them in alphabetical order of their operations, breaking ties by target. Dedicated search attributes are canonical: a criterion represented by a dedicated attribute must not also appear in select_filter/apply_filters content. Handle naming rule: A bound REF IDENT must be the normalized singular head noun of the entity; a LIST[REF[T]] must be the plural. If a collision occurs, append a numeric suffix `_2`, `_3` in source order. Existing coreference behavior remains unchanged.
- [revise] Generate: grammar `generation ::= "GENERATE" "(" generate-attr ("," generate-attr)* ")" "->" IDENT ":" gen_type
generate-attr ::= attribute-name "=" value
gen_type ::= "NUMBER" | "STRING" | "BOOL" | "LIST" "[" gen_type"]"` — Only target, audience, audience_role, content, duration, duration_unit, exclude, format, locale, quantity, style, and tone are legal Generate attributes, validated against their attribute-name rules. Canonical ordering rule: Attributes must be emitted in exactly their declared signature order (target first, followed by any optional attributes sorted alphabetically by attribute name). Independent sequential generated steps without a source-imposed order must be emitted in alphabetical order of their target values. target is required and must be an artifact-specification target member. Handle naming rule: The bound IDENT must reflect the target artifact's normalized noun (singular for STRING/NUMBER/BOOL, plural for LIST). If a collision occurs, append a numeric suffix `_2`, `_3` in source order. duration and duration_unit must occur together. content and exclude remain transitional STRING channels. All prior GENERATE result, REF prohibition, and exact quantity semantics remain unchanged.
