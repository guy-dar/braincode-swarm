-- check_replied(target, deadline) -> BOOL [VALUE]
-- file_age_days(target) -> NUMBER [VALUE]
-- path_in_folder(target, destination) -> BOOL [VALUE]
-- create_list(target) -> REF[STRING] [NEW]
