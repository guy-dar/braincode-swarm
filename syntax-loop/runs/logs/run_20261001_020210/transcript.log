   "membership_rule": "This index is exhaustive across all retained constructs and Action/Generate/Utterance signatures. Legacy transitional STRING attributes have been removed to enforce N3. The exact domain is determined by the specific operation signature.",
   "worked_example": {
    "nl": "Find dog collars.",
    "braincode": "ACTION search_web(target=dog_collar) -> collars : LIST[REF[STRING]]"
   },
   "change_type": "MAJOR",
   "rationale": "Removes transitional STRING attributes entirely to comply with N3. Defers exact domain typing to operation signatures. Adds compositional attributes for relations, participants, predicates, ingredients, and evidence.",
   "addresses_note": "N3"
  },
  {
   "op": "revise",
   "construct_name": "Generate",
   "grammar": "generation ::= \"GENERATE\" \"(\" generate-attr (\",\" generate-attr)* \")\" \"->\" IDENT \":\" type\ngenerate-attr ::= attribute-name \"=\" value\n-- Legal attributes: target, audience, budget, character_properties, constraints, content, currency, dietary_restrictions, duration, duration_unit, events, evidence_requirements, format, ingredients, locale, max_prep_time, max_walk_duration, max_walk_duration_unit, participants, predicates, quantity, quantity_unit, stop_min_per_day, stop_requirement, style, tone, topic, transformations.",
   "semantics": "target requires STRING<artifact-value>; audience requires STRING<recipient-value>; tone, format, style, locale, currency, duration_unit, max_walk_duration_unit, and quantity_unit require their named categories; duration, quantity, max_walk_duration, max_prep_time, stop_min_per_day, budget require NUMBER. constraints requires LIST[STRING<constraint-value>]; transformations requires LIST[STRING<transformation-value>]; events requires LIST[STRING<event-value>]; character_properties requires LIST[STRING<character-property-value>]; participants requires LIST[STRING<participant-value>]; predicates requires LIST[STRING<predicate-value>]; evidence_requirements requires LIST[STRING<evidence-value>]; ingredients requires LIST[STRING<food-value>]; dietary_restrictions requires LIST[STRING<dietary-value>]. topic requires STRING<topic-value>. content requires STRING<content-value>. stop_requirement requires STRING<semantic-category-value>. Target is first; remaining attributes are alphabetical.",
   "worked_example": {
    "nl": "Plan a healthy light dinner.",
    "braincode": "GENERATE(target=art_meal_plan, dietary_restrictions=[dietary_healthy, dietary_light, dietary_satiating], ingredients=[food_simple_ingredients], max_prep_time=30, topic=topic_tonight_dinner) -> dinner_plan : STRING"
   },
   "glossary_gloss": "Generate creates a non-effectful artifact with governed descriptive constraints, topics, events, food properties, and transformations.",
   "change_type": "MAJOR",
   "rationale": "Adds compositional lists for events, character_properties, dietary, ingredients, and evidence to improve expressivity and fully decompose requests.",
   "cites_source": "HTML",
   "addresses_note": "N3"
  },
  {
   "op": "revise",
