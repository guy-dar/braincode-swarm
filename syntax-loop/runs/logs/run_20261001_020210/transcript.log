>,location:STRING<location-name>,state:STRING<state-value>])->REF[STRING]; place(target:REF[STRING],destination:STRING<entity-name>,[relation:STRING<spatial-relation>,state:STRING<state-value>]); place(target:REF[STRING],location:STRING<location-name>,[relation:STRING<spatial-relation>,state:STRING<state-value>]); heat(target:REF[STRING],[destination:STRING<entity-name>])->REF[STRING]; chill(target:REF[STRING],[destination:STRING<entity-name>])->REF[STRING]; rinse(target:REF[STRING],[destination:STRING<entity-name>])->REF[STRING]; slice(target:REF[STRING])->REF[STRING]; pour(target:REF[STRING],destination:STRING<entity-name>); open_container(target:REF[STRING]); close_container(target:REF[STRING]); turn_on(target:REF[STRING]); turn_off(target:REF[STRING]). Shopping/Booking: add_to_cart(target:REF[STRING]); save_favorite(target:REF[STRING]); set_active_store(target:REF[STRING]); book(target:REF[STRING]); select_schedule(target:REF[STRING]). Comm/Status: send_email(recipient:STRING<recipient-value>,[content:STRING<content-value>,tone:STRING<tone-value>]); send_message(recipient:STRING<recipient-value>,[content:STRING<content-value>,tone:STRING<tone-value>]); call(recipient:STRING<recipient-value>,[content:STRING<content-value>]); check_replied(target:STRING<recipient-value>,deadline:UTC_TIMESTAMP)->BOOL; check_support_status(target:STRING<entity-name>,metric:STRING<metric-value>)->BOOL; check_support_status(target:REF[STRING],metric:STRING<metric-value>)->BOOL; offer_discount(target:STRING<entity-name>,[content:STRING<content-value>,discount_percent:NUMBER]); offer_discount(target:REF[STRING],[content:STRING<content-value>,discount_percent:NUMBER]); offer_expedited_shipping(target:STRING<entity-name>); offer_expedited_shipping(target:REF[STRING]). Code/Files: modify_code(target:STRING<platform-name>,file:STRING<code-value>,[method:STRING<code-value>,property:STRING<code-value>,call:STRING<code-value>,assertion:STRING<code-value>,expected_output:STRING<code-value>,actual_output:STRING<code-value>,reproduction_step:STRING<code-value>,revision:STRING<code-value>]); modify_code(target:STRING<entity-name>,file:STRING<code-value>,[method:STRING<code-value>,property:STRING<code-value>,call:STRING<code-value>,assertion:STRING<code-value>,expected_output:STRING<code-value>,actual_output:STRING<code-value>,reproduction_step:STRING<code-value>,revision:STRING<code-value>]); run_tests(target:STRING<platform-name>,[assertion:STRING<code-value>,content:STRING<content-value>]); run_tests(target:STRING<entity-name>,[assertion:STRING<code-value>,content:STRING<content-value>]); add_file(target:STRING<platform-name>,file:STRING<code-value>,[content:STRING<content-value>]); add_file(target:STRING<entity-name>,file:STRING<code-value>,[content:STRING<content-value>]); delete_file(target:STRING<platform-name>,file:STRING<code-value>); delete_file(target:STRING<entity-name>,file:STRING<code-value>); file_age_days(file:STRING<code-value>)->NUMBER; path_in_folder(file:STRING<code-value>,source:STRING<code-value>)->BOOL. custom_<domain>_<action> requires target:STRING<entity-name> and may use content:STRING<content-value>. Prefix restrictions for code-value: file/source require path_; method/property require sym_; call requires call_; revision requires chg_; assertion requires assert_; expected_output/actual_output require outcome_; reproduction_step requires repro_.
