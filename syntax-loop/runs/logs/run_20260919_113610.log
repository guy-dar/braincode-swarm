2026-09-19 11:41:21,568 [DEBUG] HTTP Response: POST https://api.openai.com/v1/chat/completions "200 OK" Headers([('date', 'Sat, 19 Sep 2026 08:41:21 GMT'), ('content-type', 'application/json'), ('transfer-encoding', 'chunked'), ('connection', 'keep-alive'), ('cf-ray', 'a3d748f7e90c5851-ATH'), ('cf-cache-status', 'DYNAMIC'), ('server', 'cloudflare'), ('strict-transport-security', 'max-age=31536000; includeSubDomains; preload'), ('x-content-type-options', 'nosniff'), ('access-control-expose-headers', 'X-Request-ID'), ('access-control-expose-headers', 'CF-Ray'), ('access-control-expose-headers', 'CF-Ray'), ('openai-organization', 'user-et0f0ef9kqco7qmwo7c8egdx'), ('openai-processing-ms', '59551'), ('openai-project', 'proj_AEdaHtN8Kfcvm3GzTCc171PF'), ('openai-version', '2020-10-01'), ('x-openai-proxy-wasm', 'v0.1'), ('x-ratelimit-limit-requests', '500'), ('x-ratelimit-limit-tokens', '500000'), ('x-ratelimit-remaining-requests', '499'), ('x-ratelimit-remaining-tokens', '492836'), ('x-ratelimit-reset-requests', '120ms'), ('x-ratelimit-reset-tokens', '859ms'), ('x-request-id', 'req_7b639bb90cf548a4bb13b767bd6dd676'), ('set-cookie', '__cf_bm=ELGka6ivTP_8RpirW5twDIhdRlS3mnbDRebi3zsYSsk-1789807220.4695826-1.0.1.1-cB2T828T9d8w9mPyi7jU7gJFhduiPTvP8GkvCBVcMzXpKWzPkSe6ZXTmvbxV2QVKYJFu01fbAOLLIxWgXeTVn1W.H57LW4Jacx2Yvve3UrelxZnF0vbC3w3uOvnQ4zAZ; HttpOnly; SameSite=None; Secure; Path=/; Domain=api.openai.com; Expires=Sat, 19 Sep 2026 09:11:21 GMT'), ('content-encoding', 'br'), ('alt-svc', 'h3=":443"; ma=86400')])
