{"braincode": "ENTRYPOINT $v1\n\nCONVO $v1 {\n  TURN $v2 SPEAKER=USER {\n    UTTER int_compare_request(a_items=[ent_spiderman_2, ent_baldurs_gate_3])\n  }\n}"}

