 "changes": [
  {
   "op": "revise",
   "construct_name": "Types & Lexicon",
   "grammar": "type ::= NUMBER | BOOL | DATE | TIME | URL | PATH | NAME | ENTITY | ROLE | VALUE | PROPOSITION | CODE | CODEATOM | LIST \"[\" type \"]\" | REF \"[\" type \"]\"\nvalue ::= literal | ontology_symbol | HANDLE | list_lit | proposition | code | diff\nliteral ::= NUMBER_LITERAL | TRUE | FALSE | DATE_LITERAL | TIME_LITERAL | URL_LITERAL | PATH_LITERAL | NAME_LITERAL\nlist_lit ::= \"[\" value (\",\" value)* \"]\"\nproposition ::= intent_symbol \"(\" field_list? \")\"\ncode ::= code_constructor \"(\" field_list? \")\"\nfield_list ::= field (\",\" field)*\nfield ::= attribute_symbol \"=\" value\ndiff ::= HANDLE \"-\" NUMBER_LITERAL\nHANDLE ::= \"$v\" POSITIVE_INTEGER\nPOSITIVE_INTEGER ::= [1-9][0-9]*\nNUMBER_LITERAL ::= \"-\"? (\"0\" | [1-9][0-9]*) (\".\" DIGIT+)?\nDATE_LITERAL ::= \"@d\" DIGIT DIGIT DIGIT DIGIT \"-\" MONTH \"-\" DAY\nTIME_LITERAL ::= \"@t\" HOUR \":\" MINUTE \":\" SECOND \"Z\"\nURL_LITERAL ::= \"@uhttps://\" URL_HOST URL_PATH?\nPATH_LITERAL ::= \"@p\" PATH_SEGMENT (\"/\" PATH_SEGMENT)*\nNAME_LITERAL ::= \"@n\" NAME_CHAR+\nontology_symbol ::= exact glossary member of operation-symbol | intent-symbol | entity-symbol | role-symbol | value-symbol | attribute-symbol | code-constructor | code-atom\n-- DIGIT is one of 0..9; MONTH is 01..12; DAY is 01..31; HOUR is 00..23; MINUTE and SECOND are 00..59; URL_HOST and URL_PATH use only ASCII letters, digits, '.', '-', '_', '/'; PATH_SEGMENT is nonempty ASCII letters/digits/'.'/'-'/'_' and is not '.' or '..'; NAME_CHAR is ASCII letter, digit, '_' or '-'.",
   "semantics": "Grammar names such as type, DIGIT, MONTH, field_list, and ontology_symbol are metalanguage notation and never source tokens. DATE_LITERAL is valid only for an existing proleptic-Gregorian date. URL_LITERAL is an absolute HTTPS URL under the stated local grammar. PATH_LITERAL is a normalized relative path. NAME_LITERAL is one atomic name token, never a phrase. No STRING, quoted text, comment, unrestricted IDENT, or implicit external lexical standard exists. Every ontology symbol, including every CODEATOM, requires an exact glossary entry; each code atom declares one atomic subtype: code-identifier, code-string, code-number, code-module, code-framework, code-locale, code-status, or code-output. Handles are allocated $v1 to the ENTRYPOINT declaration and then monotonically in preorder declaration/binding order; later use must use the allocated handle.",
   "worked_example": {
    "nl": "On 10 June 2025, ask the manager for a two-day extension.",
    "braincode": "ENTRYPOINT $v1\nTASK $v1 ANCHOR @d2025-06-10 {\n  ACTION op_send_email(a_recipient=role_manager,a_content=int_request_extension(a_recipient=role_manager,a_duration=2,a_unit=val_day))\n}"
   },
   "glossary_gloss": "Types & Lexicon defines every legal value and token form. BrainCode has no text strings or comments; descriptive meaning comes from structured glossary symbols.",
   "change_type": "MAJOR",
   "rationale": "This closes the universal string and identifier channels and precisely distinguishes source tokens from grammar notation.",
   "cites_source": "Formal language theory",
   "addresses_note": "N1"
  },
  {
   "op": "add",
   "kind": "vocabulary",
   "construct_name": "structural-symbol",
   "glossary_gloss": "Structural symbols are BrainCode's complete fixed keywords, operators, delimiters, types, and literal prefixes. They have syntax roles only; descriptive meaning belongs to ontology symbols.",
   "closed": true,
   "members": [
    {
     "symbol": "ENTRYPOINT TASK ANCHOR ACTION UTTER GENERATE CONVO TURN SPEAKER USER AGENT REPLY_TO REVISES IF THEN ELSE FOR EACH IN ANY ALL SATISFIES LET RETURN DECREASES",
     "gloss": "The complete set of declaration, control-flow, binding, and conversation keywords.",
     "nl_synonyms": []
    },
    {
     "symbol": "AND OR NOT TRUE FALSE NUMBER BOOL DATE TIME URL PATH NAME ENTITY ROLE VALUE PROPOSITION CODE CODEATOM LIST REF",
     "gloss": "The complete set of boolean words and type names.",
     "nl_synonyms": []
    },
    {
     "symbol": "== != < <= > >= -> = : - ( ) { } [ ] , $v @d @t @u @p @n",
     "gloss": "The complete set of operators, delimiters, handle prefix, and literal prefixes.",
     "nl_synonyms": []
    }
   ],
   "membership_rule": null,
   "worked_example": {
    "nl": "Bind a number and test it.",
    "braincode": "ENTRYPOINT $v1\nTASK $v1 {\n  LET $v2:NUMBER=2\n  IF $v2>1 THEN { ACTION op_wait() }\n}"
   },
   "change_type": "MINOR",
   "rationale": "This gives every fixed source token a direct glossary lookup rather than relying on an informal reserved-word list.",
   "addresses_note": "N1"
  },
  {
   "op": "add",
   "kind": "vocabulary",
   "construct_name": "ontology-symbol",
   "glossary_gloss": "Ontology symbols are exact descriptive tokens for operations, intents, entities, roles, attributes, values, code forms, and code atoms. Each schema below fixes field order, permitted types, defaults, result type, and construct choice.",
   "closed": false,
   "members": [
    {
     "symbol": "op_find",
     "gloss": "Operation schema: a_target:ENTITY required, a_source:ENTITY optional, a_max_price:NUMBER optional, a_currency:VALUE[currency] optional, a_requirement:PROPOSITION optional, a_quantity:NUMBER required. Fields occur in that order; no defaults or duplicates. Returns REF[ENTITY] when quantity is 1, otherwise LIST[REF[ENTITY]]. Use for locating or selecting.",
     "nl_synonyms": [
      "find",
      "search",
      "locate"
     ]
    },
    {
     "symbol": "op_pick_up op_remove op_place op_heat",
     "gloss": "Household schemas: op_pick_up(a_target:REF[ENTITY]) returns same REF; op_remove(a_target:REF[ENTITY],a_source:ENTITY|REF[ENTITY]) returns same REF; op_place(a_target:REF[ENTITY],a_destination:ENTITY|REF[ENTITY]) requires a held REF and returns none; op_heat(a_target:REF[ENTITY],a_destination:ENTITY) returns same REF. Fields are listed order, required, unique.",
     "nl_synonyms": [
      "pick up",
      "remove",
      "place",
      "heat"
     ]
    },
    {
     "symbol": "op_add_to_cart op_check_replied op_send_email op_modify_code op_wait",
     "gloss": "Operation schemas: cart(a_target:REF[ENTITY]); replied(a_target:ROLE,a_deadline:DATE); email(a_recipient:ROLE,a_content:PROPOSITION); modify(a_path:PATH,a_change:CODE,a_regression:CODE optional); wait() has no fields. All fields are ordered, unique, and have no defaults. Results are respectively none, BOOL, none, none, none.",
     "nl_synonyms": [
      "add to cart",
      "check replied",
      "send email",
      "modify code",
      "wait"
     ]
    },
    {
     "symbol": "int_request_extension int_follow_up int_compatible_with",
     "gloss": "Intent schemas: extension(a_recipient:ROLE,a_duration:NUMBER,a_unit:VALUE[duration-unit],a_tone:VALUE[tone] optional); follow-up(a_tone:VALUE[tone]); compatible(a_reference:REF[ENTITY]). Fields are ordered, required unless optional, unique, and have no defaults.",
     "nl_synonyms": [
      "ask for extension",
      "follow up",
      "compatible with"
     ]
    },
    {
     "symbol": "int_recipe_request int_nutrition_question int_duration_question int_recommend int_opening_hours_question int_weather_condition",
     "gloss": "Question schemas: recipe(a_target:ENTITY,a_nutrient:VALUE[nutrient] optional,a_requirement:PROPOSITION|VALUE[review] optional); nutrition(a_reference:PROPOSITION,a_nutrient:VALUE[nutrient]); duration(a_reference:PROPOSITION,a_measure:VALUE[measure]); recommend(a_target:ENTITY,a_location:ENTITY optional,a_requirement:PROPOSITION|VALUE[criterion] optional,a_quantity:NUMBER optional); opening-hours(a_target:ENTITY,a_requirement:VALUE[availability]); weather(a_state:VALUE[weather]). Fields follow shown order and are unique.",
     "nl_synonyms": [
      "recipe",
      "protein question",
      "duration question",
      "recommend",
      "opening hours",
      "rain"
     ]
    },
    {
     "symbol": "int_explain int_opinion_request int_capability_question int_continue int_generate_artifact",
     "gloss": "Intent schemas: explain(a_topic:ENTITY,a_depth:VALUE[depth] optional,a_audience:ROLE|ENTITY|VALUE[age] optional,a_register:VALUE[register] optional,a_requirement:PROPOSITION|LIST[VALUE] optional); opinion(a_topic:ENTITY,a_subject:ROLE optional); capability(a_subject:ROLE,a_capability:VALUE[capability]); continue(a_reference:PROPOSITION,a_depth:VALUE[depth] optional); artifact(a_artifact:VALUE[artifact],a_specification:PROPOSITION,a_audience:ROLE|ENTITY optional,a_register:VALUE[register] optional,a_reference:PROPOSITION optional). Ordered fields, no duplicates or defaults.",
     "nl_synonyms": [
      "explain",
      "opinion",
      "can",
      "continue",
      "generate"
     ]
    },
    {
     "symbol": "int_script_request int_homiletics_request int_email_exchange int_plan_trip int_crud_design_advice int_meal_prep_request int_medical_prognosis_request",
     "gloss": "Artifact-specification schemas: script(a_cast:LIST[ENTITY],a_source_event:ENTITY,a_tone:VALUE[tone],a_rating:VALUE[rating],a_components:LIST[VALUE]); homiletics(a_religion:VALUE[religion],a_requirement:LIST[VALUE]); email(a_sender:ROLE,a_recipient:ROLE,a_position:ENTITY optional,a_topic:ENTITY,a_relation:VALUE[relation]); trip(a_destination:ENTITY,a_duration:NUMBER,a_unit:VALUE[duration-unit],a_interest:ENTITY,a_origin:ENTITY,a_budget_amount:NUMBER,a_budget_currency:VALUE[currency],a_requirement:VALUE[criterion]); crud(a_stack:LIST[ENTITY],a_project:ENTITY,a_operations:LIST[VALUE],a_question:VALUE[ui-choice],a_requirement:VALUE[criterion]); meal(a_duration:NUMBER,a_unit:VALUE[duration-unit],a_meals:LIST[VALUE],a_nutrient:VALUE[nutrient],a_requirement:LIST[VALUE]); prognosis(a_condition:ENTITY,a_measure:VALUE[measure],a_measurement:NUMBER,a_unit:VALUE[unit],a_intervention:VALUE[intervention],a_audience:VALUE[age],a_register:VALUE[register]). Fields are shown canonical order and are required.",
     "nl_synonyms": [
      "script",
      "sermon guidance",
      "email exchange",
      "trip plan",
      "CRUD advice",
      "meal prep",
      "medical prognosis"
     ]
    },
    {
     "symbol": "a_target a_source a_destination a_recipient a_content a_duration a_unit a_tone a_quantity a_max_price a_currency a_requirement a_deadline a_reference a_nutrient a_measure a_artifact a_specification a_audience a_register a_topic a_depth a_subject a_capability a_location a_cast a_source_event a_rating a_components a_religion a_sender a_position a_relation a_interest a_origin a_budget_amount a_budget_currency a_stack a_project a_operations a_question a_meals a_condition a_measurement a_intervention a_path a_change a_regression a_items a_module a_name a_value a_callee a_args a_index a_key a_expected a_actual a_locale a_status",
     "gloss": "Attribute symbols are legal only in the schemas that name them. Their permitted categories are exactly the type/category annotations in those schemas; an attribute never accepts a free word, untyped VALUE, or undocumented field.",
     "nl_synonyms": []
    },
    {
     "symbol": "val_polite val_day val_usd val_clp val_high_protein val_protein val_preparation_time val_high_reviews val_every_day val_rain val_in_depth val_more_depth val_more_detail val_casual val_hilarious val_age_17_plus val_scene val_dialogue val_reaction val_roast val_christian val_engaging val_stepwise val_expanded val_examples val_email_exchange val_recipe val_trip_plan val_technical_advice val_meal_plan val_medical_explanation val_simple val_time_saving val_percent val_without_transplant val_create val_read val_update val_delete val_modal_vs_page val_react_update_explanation",
     "gloss": "Exact members of the relevant controlled value categories. Synonymous natural-language wording maps to the one listed canonical symbol; category membership is stated by each consuming schema.",
     "nl_synonyms": [
      "politely",
      "days",
      "dollars",
      "high protein",
      "highest reviewed",
      "every day",
      "casually",
      "funny",
      "adult-oriented",
      "simple",
      "time-saving"
     ]
    },
    {
     "symbol": "code_sequence code_import code_assign code_identifier code_string code_number code_call_paren code_call_bracket code_member code_index code_list code_tuple code_dict code_pair code_function code_assert_equal code_http_request code_http_status code_locale code_edit_replace code_test_case",
     "gloss": "Typed CODE constructors: sequence(a_items:LIST[CODE]); import(a_module:CODEATOM,a_name:CODEATOM optional); assign(a_target:CODE,a_value:CODE); identifier/string/number(a_value:CODEATOM); calls(a_callee:CODE,a_args:LIST[CODE]); member(a_target:CODE,a_name:CODEATOM); index(a_target:CODE,a_index:CODE); list/tuple/dict(a_items:LIST[CODE]); pair(a_key:CODE,a_value:CODE); function(a_name:CODEATOM,a_args:LIST[CODE],a_items:LIST[CODE]); assert-equal(a_expected:CODE,a_actual:CODE); HTTP request(a_locale:CODE,a_path:CODE); HTTP status(a_status:CODEATOM); locale(a_locale:CODEATOM); replace(a_target:CODE,a_value:CODE); test-case(a_items:LIST[CODE]). Fields are ordered, required unless marked optional, and unique.",
     "nl_synonyms": []
    },
    {
     "symbol": "code_atom_x code_atom_symbols code_atom_Max code_atom_mathematica_code code_atom_string_x code_atom_number_2 code_atom_Max_bracket_output code_atom_en_latn_us code_atom_en_Latn_US code_atom_200 code_atom_404",
     "gloss": "Exact atomic code entries. Their declared subtypes are respectively code-identifier, code-identifier, code-identifier, code-identifier, code-string, code-number, code-output, code-locale, code-locale, code-status, and code-status; they are atomic symbols, not text fragments.",
     "nl_synonyms": []
    }
   ],
   "membership_rule": "A token is legal only when this complete glossary contains its exact member entry. Every future member must state category, canonical natural-language mapping, complete ordered schema if composite, permitted categories for each field, defaults, duplicate rule, result/reference type, and construct-selection rule. TASK is for external effects, UTTER for recorded dialogue, and GENERATE for symbolic artifact derivation.",
   "worked_example": {
    "nl": "Django locales en-latn-us and en-Latn-US should return 200 rather than 404.",
    "braincode": "ACTION op_modify_code(a_path=@pdjango/utils/translation/trans_real.py,a_change=code_edit_replace(a_target=code_locale(a_locale=code_atom_en_latn_us),a_value=code_locale(a_locale=code_atom_en_Latn_US)),a_regression=code_test_case(a_items=[code_assert_equal(a_expected=code_http_status(a_status=code_atom_200),a_actual=code_http_request(a_locale=code_locale(a_locale=code_atom_en_latn_us),a_path=code_identifier(a_value=code_atom_x))]))"
   },
   "change_type": "MINOR",
   "rationale": "This supplies concrete schema categories for the sampled household, web, conversation, generation, planning, medical, and SWE-bench domains rather than delegating them to an unshown ontology.",
   "addresses_note": "N1"
  },
  {
   "op": "revise",
   "construct_name": "Action",
   "grammar": "action ::= ACTION operation_symbol \"(\" field_list? \")\" (\"->\" HANDLE \":\" type)?",
   "semantics": "ACTION is the only external-state construct. Its exact operation entry supplies ordered fields, field types, result type, and canonical selection rule; unknown, duplicate, missing, out-of-order, or type-incompatible fields are static errors. Source-location retrieval is op_find followed by op_pick_up before any possession-sensitive action. A goal phrase such as ready-for-coffee canonically decomposes, when the demonstrated trajectory supplies it, as find, pick_up, heat in microwave, remove, then place at coffee-maker spout; no invented preparation operation is permitted.",
   "worked_example": {
    "nl": "Put both pillows from the sofa onto the armchair, one at a time.",
    "braincode": "ENTRYPOINT $v1\nTASK $v1 {\n  ACTION op_find(a_target=ent_pillow,a_source=ent_sofa,a_quantity=2)->$v2:LIST[REF[ENTITY]]\n  FOR EACH $v3 IN $v2 { ACTION op_pick_up(a_target=$v3)->$v4:REF[ENTITY] ACTION op_place(a_target=$v4,a_destination=ent_armchair) }\n}"
   },
   "glossary_gloss": "Action performs one exactly specified external operation. Its fields and values must be defined by that operation's glossary schema.",
   "change_type": "MAJOR",
   "rationale": "This removes free Action identifiers and payloads while fixing canonical household acquisition and goal decomposition.",
   "cites_source": "Why Agentic Systems Need Ontologies",
   "addresses_note": "N1"
  },
  {
   "op": "revise",
   "construct_name": "Utterance",
   "grammar": "utterance ::= UTTER intent_symbol \"(\" field_list? \")\" (\"->\" HANDLE \":\" PROPOSITION)?",
   "semantics": "UTTER records one non-effectful, fully symbolic conversational proposition and is legal only in a TURN. The selected intent schema supplies exact ordered fields. Its optional binding has type PROPOSITION and may be supplied to any later intent or GENERATE a_reference field that permits PROPOSITION; no REF[PROPOSITION] type exists.",
   "worked_example": {
    "nl": "Ask for a high-protein flatbread recipe.",
    "braincode": "UTTER int_recipe_request(a_target=ent_flatbread,a_nutrient=val_high_protein)->$v3:PROPOSITION"
   },
   "glossary_gloss": "Utterance records structured conversational meaning rather than quoted dialogue. Its content is an ordered symbolic intent proposition.",
   "change_type": "MAJOR",
   "rationale": "This removes conversational prose and establishes the single proposition identity model used by follow-ups and generation.",
   "cites_source": "Why Agentic Systems Need Ontologies",
   "addresses_note": "N1"
  },
  {
   "op": "revise",
   "construct_name": "Generate",
   "grammar": "generation ::= GENERATE \"(\" \"a_specification\" \"=\" proposition (\",\" \"a_reference\" \"=\" HANDLE)? \")\" \"->\" HANDLE \":\" PROPOSITION",
   "semantics": "GENERATE purely derives one symbolic artifact proposition. a_specification is required and must be int_generate_artifact or another glossary-defined artifact specification; a_reference is optional, must be a visible PROPOSITION handle, and denotes the artifact or request being answered, continued, or revised. GENERATE always binds PROPOSITION. It is selected for requested artifacts, UTTER for dialogue records, and ACTION for external effects. It is legal in TASK and TURN bodies, allowing a conversation to contain its requested symbolic artifact.",
   "worked_example": {
    "nl": "Generate a recipient response to an earlier email exchange.",
    "braincode": "GENERATE(a_specification=int_generate_artifact(a_artifact=val_email_exchange,a_specification=int_email_exchange(a_sender=role_other_party,a_recipient=role_user,a_topic=ent_collaboration,a_relation=val_next_recipient_response),a_reference=$v2),a_reference=$v2)->$v3:PROPOSITION"
   },
   "glossary_gloss": "Generate derives a structured artifact from a structured symbolic specification. It has one proposition result and never accepts or produces prose text.",
   "change_type": "MAJOR",
   "rationale": "This merges the conflicting prior definitions and gives references, generated results, and conversational generation one consistent type.",
   "cites_source": "Formal language theory",
   "addresses_note": "N1"
  },
  {
   "op": "revise",
   "construct_name": "Task",
   "grammar": "document ::= ENTRYPOINT HANDLE (task | conversation)*\ntask ::= TASK HANDLE param_list? (ANCHOR DATE_LITERAL)? (\":\" type)? (DECREASES HANDLE)? \"{\" step+ return_stmt? \"}\"\nparam_list ::= \"(\" param (\",\" param)* \")\"\nparam ::= HANDLE \":\" type\nreturn_stmt ::= RETURN value\nstep ::= action | flow_if | flow_for | bind | task_call | generation\ntask_call ::= HANDLE \"(\" field_list? \")\" (\"->\" HANDLE \":\" type)?",
   "semantics": "A document has exactly one ENTRYPOINT handle naming a declared TASK or CONVO. TASK contains executable work and symbolic generation, never UTTER. ANCHOR records a required translation-time date resolution whenever the source uses a relative date. Task parameters, calls, and results use handles only; call fields follow declared parameter order and exact types.",
   "worked_example": {
    "nl": "If the manager has not replied by Friday, send a polite follow-up.",
    "braincode": "ENTRYPOINT $v1\nTASK $v1 ANCHOR @d2026-09-30 {\n  ACTION op_check_replied(a_target=role_manager,a_deadline=@d2026-10-02)->$v2:BOOL\n  IF NOT $v2 THEN { ACTION op_send_email(a_recipient=role_manager,a_content=int_follow_up(a_tone=val_polite)) }\n}"
   },
   "glossary_gloss": "Task is an ordered executable procedure using typed opaque handles and closed symbolic values.",
   "change_type": "MAJOR",
   "rationale": "This removes unrestricted task and parameter identifiers while preserving the execution boundary.",
   "cites_source": "Formal language theory",
   "addresses_note": "N1"
  },
  {
   "op": "revise",
   "construct_name": "Bind",
   "grammar": "bind ::= LET HANDLE \":\" type \"=\" value\n-- result sites are ACTION -> HANDLE:type, task_call -> HANDLE:type, UTTER -> HANDLE:PROPOSITION, GENERATE -> HANDLE:PROPOSITION",
   "semantics": "Bind assigns a typed closed-vocabulary value to a canonical opaque handle. A handle is allocated by the global preorder rule, cannot shadow a visible handle, and cannot be used before its introduction. LET may copy a visible REF of the same type but cannot manufacture a REF from an entity, literal, proposition, or code value.",
   "worked_example": {
    "nl": "Store an extension request.",
    "braincode": "LET $v2:PROPOSITION=int_request_extension(a_recipient=role_manager,a_duration=2,a_unit=val_day)"
   },
   "glossary_gloss": "Bind stores a typed formal value under an opaque handle. Handles are defined addresses, not descriptive words.",
   "change_type": "MAJOR",
   "rationale": "Opaque handles close the former free identifier channel while retaining explicit data flow.",
   "cites_source": "Formal language theory",
   "addresses_note": "N1"
  },
  {
   "op": "revise",
   "construct_name": "Iterate",
   "grammar": "flow_for ::= FOR EACH HANDLE IN iterable \"{\" step+ \"}\"\niterable ::= HANDLE | list_lit\nquantifier ::= (ANY | ALL) HANDLE IN iterable SATISFIES check",
   "semantics": "FOR EACH, ANY, and ALL retain finite LIST typing, sequential order, lexical scope, and no-shadowing. Their introduced names are canonical handles. Every list element must itself be a closed Types & Lexicon value.",
   "worked_example": {
    "nl": "Put both pillows from the sofa onto the armchair one at a time.",
    "braincode": "ACTION op_find(a_target=ent_pillow,a_source=ent_sofa,a_quantity=2)->$v2:LIST[REF[ENTITY]]\nFOR EACH $v3 IN $v2 { ACTION op_pick_up(a_target=$v3)->$v4:REF[ENTITY] ACTION op_place(a_target=$v4,a_destination=ent_armchair) }"
   },
   "glossary_gloss": "Iterate processes a finite typed list using a formal loop handle. It cannot introduce an undocumented descriptive name.",
   "change_type": "MAJOR",
   "rationale": "This makes iteration compatible with closed handles and the possession requirement of household actions.",
   "cites_source": "Formal language theory",
   "addresses_note": "N1"
  },
  {
   "op": "revise",
   "construct_name": "Check",
   "grammar": "check ::= disjunction\ndisjunction ::= conjunction (OR conjunction)*\nconjunction ::= negation (AND negation)*\nnegation ::= NOT negation | primary\nprimary ::= \"(\" check \")\" | quantifier | comparison\ncomparison ::= value (comp_op value)?\ncomp_op ::= \"==\" | \"!=\" | \"<\" | \"<=\" | \">\" | \">=\"",
   "semantics": "Check is pure with fixed precedence OR, AND, NOT, comparison. Operands are only closed values. NUMBER supports all comparisons; BOOL, ontology symbols, PROPOSITION, CODE, REF, and LIST support equality and inequality only unless their exact glossary schema defines an ordering. Proposition equality compares intent symbol and ordered fields recursively.",
   "worked_example": {
    "nl": "Proceed only if the total exceeds 50 and membership is true.",
    "braincode": "ENTRYPOINT $v1\nTASK $v1 {\n  LET $v2:NUMBER=65\n  LET $v3:BOOL=TRUE\n  IF $v2>50 AND $v3==TRUE THEN { ACTION op_wait() }\n}"
   },
   "glossary_gloss": "Check forms a true-or-false condition from typed closed values. It cannot inspect unknown text or identifiers.",
   "change_type": "MAJOR",
   "rationale": "This prevents conditions from restoring string or identifier escape hatches.",
   "cites_source": "Formal language theory",
   "addresses_note": "N1"
  },
  {
   "op": "revise",
   "construct_name": "Flow-If",
   "grammar": "flow_if ::= IF check THEN \"{\" step+ \"}\" (ELSE \"{\" step+ \"}\")?",
   "semantics": "Conditional branching retains source-order evaluation and child scopes. Its condition is a closed Check, and each branch can contain only closed TASK step forms.",
   "worked_example": {
    "nl": "If there is no reply by 6 June, send a polite follow-up.",
