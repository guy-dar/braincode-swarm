email"]}, {"symbol": "act_search_travel", "gloss": "Search for travel options using symbolic travel criteria.", "nl_synonyms": ["search flights", "find flights"]}, {"symbol": "act_rinse", "gloss": "Rinse a physical entity at a destination.", "nl_synonyms": ["rinse", "wash"]}, {"symbol": "act_place", "gloss": "Place a referenced entity at a destination.", "nl_synonyms": ["put", "place"]}, {"symbol": "act_check_replied", "gloss": "Query whether a recipient has replied by a deadline.", "nl_synonyms": ["check reply", "has replied"]}], "membership_rule": "An operation symbol has exact form act_[a-z0-9_]+ and is valid only when the complete glossary contains an operation entry with that symbol, one canonical signature, one result type, and one result-identity classification. A source operation may not use an unregistered act_ token.", "worked_example": {"nl": "Rinse the mug in the sink.", "braincode": "ACTION act_rinse(target=entity_mug, destination=entity_sink) -> $mug : REF[PROPOSITION]"}, "change_type": "MINOR", "rationale": "Replacing Action's unrestricted IDENT operation slot is necessary to make operation names and their signatures glossary-defined.", "addresses_note": "N1"}, {"op": "add", "kind": "vocabulary", "construct_name": "entity-symbol", "glossary_gloss": "Entity symbols name objects, places, systems, documents, and domain concepts used as subjects or destinations. Their meaning comes from the glossary, not from English word formation.", "closed": false, "members": [{"symbol": "entity_mug", "gloss": "A mug.", "nl_synonyms": ["mug", "cup"]}, {"symbol": "entity_sink", "gloss": "A sink.", "nl_synonyms": ["sink"]}, {"symbol": "entity_coffee_maker", "gloss": "A coffee-making appliance.", "nl_synonyms": ["coffee maker", "coffee machine"]}, {"symbol": "entity_tel_aviv", "gloss": "Tel Aviv.", "nl_synonyms": ["Tel Aviv"]}, {"symbol": "entity_berlin", "gloss": "Berlin.", "nl_synonyms": ["Berlin"]}], "membership_rule": "An entity symbol has exact form entity_[a-z0-9_]+