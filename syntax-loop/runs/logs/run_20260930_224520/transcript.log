{"braincode": "ENTRYPOINT $v1\nCONVO $v1 {\n  TURN $v2 SPEAKER=USER {\n    UTTER int_request_recipe(attr_topic=ent_high_protein_flatbread, attr_tone=val_polite)\n  }\n}"}

