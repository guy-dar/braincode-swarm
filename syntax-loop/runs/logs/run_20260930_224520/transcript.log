  {
   "op": "add",
   "kind": "vocabulary",
   "construct_name": "operation-symbol",
   "glossary_gloss": "Operation symbols name external operations and define their complete schemas and canonical decomposition rules.",
   "closed": false,
   "members": [
    {
     "symbol": "op_find",
     "gloss": "Finds entities. Required ordered attributes: attr_target. Optional: attr_source, attr_platform, attr_genre, attr_max_price, attr_currency, attr_state, attr_ordering, attr_quantity. Returns LIST[REF[ENTITY]] or REF[ENTITY]. Canonical rule: Live search must use op_find. Filters, sorting, and extraction must be encoded as attributes on op_find (e.g. attr_ordering) rather than separate operations if the target platform supports them in a single query.",
     "nl_synonyms": [
      "find"
     ]
    },
    {
     "symbol": "op_place",
     "gloss": "Places entity. Required: attr_target, attr_destination.",
     "nl_synonyms": [
      "put"
     ]
    },
    {
     "symbol": "op_send_email",
     "gloss": "Sends email. Required: attr_recipient, attr_content.",
     "nl_synonyms": [
      "email"
     ]
    },
    {
     "symbol": "op_check_replied",
     "gloss": "Checks reply. Required: attr_target, attr_deadline.",
     "nl_synonyms": [
      "check reply"
     ]
    },
    {
     "symbol": "op_modify_code",
     "gloss": "Modifies code. Required: attr_path, attr_change.",
     "nl_synonyms": [
      "fix"
     ]
    },
    {
     "symbol": "op_rinse",
     "gloss": "Rinses entity. Required: attr_target, attr_destination.",
     "nl_synonyms": [
      "rinse"
     ]
    },
    {
     "symbol": "op_slice",
     "gloss": "Slices entity. Required: attr_target. Returns LIST[REF[ENTITY]]. Canonical rule: Slicing must use op_slice, not op_find.",
     "nl_synonyms": [
      "slice"
     ]
    },
    {
     "symbol": "op_heat",
     "gloss": "Heats entity. Required: attr_target, attr_destination.",
     "nl_synonyms": [
      "microwave"
     ]
    },
    {
     "symbol": "op_extract",
     "gloss": "Extracts from list. Required: attr_target, attr_quantity.",
     "nl_synonyms": [
      "extract"
     ]
    },
