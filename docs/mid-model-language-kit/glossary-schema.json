{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lossless glossary packaging schema",
  "description": "Validates the container, not BrainCode meanings, signatures, acceptance or typing.",
  "type": "object",
  "required": ["format_version", "conversion", "source_file", "source_sha256", "encoding", "authority", "sections", "entries"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": "1.0"},
    "conversion": {"type": "string"},
    "source_file": {"type": "string"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "encoding": {"const": "utf-8"},
    "authority": {"type": "string"},
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "title", "level", "start_line", "raw_markdown"],
        "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "level": {"type": "integer", "minimum": 0, "maximum": 6}, "start_line": {"type": "integer", "minimum": 1}, "raw_markdown": {"type": "string"}}
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["symbol", "occurrences", "source_alias_hints"],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "source_alias_hints": {"type": "array", "items": {"type": "string"}},
          "occurrences": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["section_id", "section_title", "source_line", "headers", "cells", "raw_row"],
              "properties": {"section_id": {"type": "string"}, "section_title": {"type": "string"}, "source_line": {"type": "integer", "minimum": 1}, "headers": {"type": "array", "items": {"type": "string"}}, "cells": {"type": "array", "items": {"type": "string"}}, "raw_row": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
