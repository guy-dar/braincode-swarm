# Copy this file to .env and fill in real values. .env is gitignored and
# loaded automatically by spawn_batch.py — no need to `export` anything by hand.

# Required: the LLM backend every harness talks to (see ../vertex-proxy).
PROXY_API_KEY=sk-your-key-here
PROXY_BASE_URL=https://vertex-proxy-v26q.onrender.com/v1

# Optional tuning — these are the same defaults spawn_batch.py uses if unset.
SWARM_HARNESS=pi
SWARM_TASK=discovery
SWARM_MODEL=vertex-proxy/gemini-flash
SWARM_CONCURRENCY=4

# Optional: tags every record processed by this run with an experiment name in
# its metadata.json (e.g. which mined dataset or exploration epoch it's from).
# Unset by default.
SWARM_EXPERIMENT=
