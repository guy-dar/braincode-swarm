{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "vertex-proxy": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Vertex Proxy",
      "options": {
        "baseURL": "{env:PROXY_BASE_URL}",
        "apiKey": "{env:PROXY_API_KEY}"
      },
      "models": {
        "gemini-flash": { "name": "Gemini 3.7 Flash" },
        "gemini-flash-high": { "name": "Gemini 3.7 Flash (high effort)" },
        "gemini-3.5-flash": { "name": "Gemini 3.5 Flash" }
      }
    }
  },
  "model": "vertex-proxy/gemini-flash"
}
